{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"title": "Info",
	"slug": "info",
	"blockTypes": [
		"core/group",
		"core/paragraph",
		"core/list",
		"core/quote"
	],
	"styles": {
		"color": {
			"text": "var:preset|color|contrast"
		},
		"border": {
			"color": "var:preset|color|info",
			"style": "solid",
			"width": "1px"
		},
		"spacing": {
			"padding": {
				"top": "1em",
				"right": "1em",
				"bottom": "1em",
				"left": "1em"
			},
			"margin": {
				"top": "1em",
				"bottom": "1em"
			}
		}
	}
}
