{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"title": "Terminal",
	"slug": "terminal",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|terminal",
			"text": "var:preset|color|base"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|mono"
		},
		"spacing": {
			"padding": {
				"top": "24px",
				"right": "24px",
				"bottom": "24px",
				"left": "24px"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|blossom"
				}
			}
		}
	}
}
